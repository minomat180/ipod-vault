#!/usr/bin/env bash
# vault - CLI for the encrypted password vault on the iPod.
#
#   vault                    interactive fzf picker (default, run in a terminal)
#   vault ls                 list entries (label, username, date; no passwords)
#   vault add [label]        add a new entry
#   vault edit <label>       edit an existing entry
#   vault rm <label>         delete an entry
#   vault get <label>        copy password to clipboard (--user: username, --show: print both)
#   vault import             read TSV "label<TAB>user<TAB>pass" on stdin, merge into the vault
#   vault mount              mount the iPod by filesystem label, healing a stale mount
#   vault umount             unmount the iPod
#   vault decrypt            print the decrypted vault to stdout (for pipes)
#
# Environment (all optional):
#   IPOD_VAULT_MOUNT     mount point                         (default /mnt/ipod)
#   IPOD_VAULT_LABEL     filesystem label of the iPod        (default IPOD)
#   IPOD_VAULT_DIR       use this directory instead of the iPod; skips mounting
#   IPOD_VAULT_IDENTITY  age identity file instead of the gnome-keyring item
#
# Storage: <mount>/vault/vault.age, age ciphertext only. The age private key
# lives in gnome-keyring, never on the iPod. The decrypted vault exists only in
# pipes and shell variables; it is never written to a file.
set -euo pipefail

MP="${IPOD_VAULT_MOUNT:-/mnt/ipod}"
LABEL="${IPOD_VAULT_LABEL:-IPOD}"
VDIR="${IPOD_VAULT_DIR:-$MP/vault}"
ENC="$VDIR/vault.age"
IDFILE="${IPOD_VAULT_IDENTITY:-}"
SVC="ipod-vault"
HERE="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")" && pwd)"

msg()  { printf '\033[1;36m==>\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m!!\033[0m %s\n' "$*" >&2; }
err()  { printf '\033[1;31mERROR:\033[0m %s\n' "$*" >&2; }

identity() {
    if [ -n "$IDFILE" ]; then cat "$IDFILE"
    else secret-tool lookup service "$SVC" key age-identity; fi
}
recipient() {
    if [ -n "$IDFILE" ]; then age-keygen -y "$IDFILE"
    else secret-tool lookup service "$SVC" key recipient; fi
}

find_dev() { blkid -L "$LABEL" 2>/dev/null; }

ensure_mounted() {
    if [ -n "${IPOD_VAULT_DIR:-}" ]; then mkdir -p "$VDIR"; return 0; fi
    local dev; dev="$(find_dev || true)"
    if mountpoint -q "$MP"; then
        local cur; cur="$(findmnt -no SOURCE "$MP" 2>/dev/null || true)"
        if [ -n "$dev" ] && [ "$cur" != "$dev" ]; then
            sudo umount -l "$MP" 2>/dev/null || true
        else
            return 0
        fi
    fi
    if [ -z "$dev" ]; then err "iPod not connected."; exit 1; fi
    sudo mkdir -p "$MP"
    sudo mount -o uid="$(id -u)",gid="$(id -g)" "$dev" "$MP"
    mkdir -p "$VDIR"
}

do_umount() {
    if [ -n "${IPOD_VAULT_DIR:-}" ]; then
        msg "IPOD_VAULT_DIR is set; nothing to unmount."; return 0
    fi
    if mountpoint -q "$MP"; then
        sync; sudo umount "$MP" && msg "iPod safely unmounted - OK to unplug."
    else
        warn "iPod not mounted."
    fi
}

# Decrypt to stdout (RAM/pipe only). Requires vault.age to exist.
decrypt() {
    ensure_mounted
    [ -f "$ENC" ] || { printf '# label\tusername\tpassword\tdate\n'; return 0; }
    age -d -i <(identity) "$ENC"
}

# Re-encrypt: reads plaintext on stdin, writes ciphertext to $ENC atomically.
encrypt_stdin() {
    ensure_mounted
    local r tmp; r="$(recipient)"
    tmp="$(mktemp "$VDIR/.vault.XXXXXX.age")"
    age -r "$r" -o "$tmp" -
    mv -f "$tmp" "$ENC"
}

# All data rows (no header/comments), tab-separated: label user pass date
rows() { decrypt | awk -F'\t' 'NF>=4 && $1!~/^#/'; }

find_row() { # find_row <label> -> last matching row, or empty
    rows | awk -F'\t' -v l="$1" '$1==l{r=$0} END{print r}'
}

copy_clear() {
    printf '%s' "$1" | wl-copy
    ( sleep 45; wl-copy --clear; notify-send -t 2500 "vault" "Clipboard cleared." >/dev/null 2>&1 ) \
        >/dev/null 2>&1 & disown
    msg "Copied to clipboard - clears in 45s."
}

read_password_choice() { # prompts, echoes chosen password to stdout
    local current="${1:-}"
    echo "  1) auto-generate (32 chars)" >&2
    echo "  2) type your own" >&2
    [ -n "$current" ] && echo "  3) keep current" >&2
    local choice; read -rp "  choice [1]: " choice </dev/tty
    case "${choice:-1}" in
        2)
            local pw pw2
            read -rsp "  new password: " pw </dev/tty; echo >&2
            read -rsp "  confirm:       " pw2 </dev/tty; echo >&2
            if [ "$pw" != "$pw2" ]; then err "Passwords did not match."; exit 1; fi
            printf '%s' "$pw"
            ;;
        3)
            [ -z "$current" ] && { err "No current password to keep."; exit 1; }
            printf '%s' "$current"
            ;;
        *)
            "$HERE/genpass.sh" -l 32
            ;;
    esac
}

# ---------------------------------------------------------------- commands --

cmd_ls() {
    local r; r="$(rows)"
    if [ -z "$r" ]; then msg "Vault is empty."; return 0; fi
    { printf 'LABEL\tUSERNAME\tDATE\n'
      printf '%s\n' "$r" | awk -F'\t' -v OFS='\t' '{print $1, ($2==""?"-":$2), $4}'
    } | column -t -s $'\t'
}

cmd_add() {
    ensure_mounted
    local label="${1:-}"
    if [ -z "$label" ]; then read -rp "label (e.g. web/github): " label </dev/tty; fi
    [ -z "$label" ] && { err "label required."; exit 1; }

    # Decrypt once, up front: if it fails, set -e stops here, before anything
    # is re-encrypted over vault.age.
    local plain; plain="$(decrypt)"

    if [ -n "$(printf '%s\n' "$plain" | awk -F'\t' -v l="$label" 'NF>=4 && $1==l')" ]; then
        warn "'$label' already exists - editing it instead."
        cmd_edit "$label"
        return 0
    fi

    local user pw
    read -rp "username/email for $label: " user </dev/tty
    msg "Password for $label:"
    pw="$(read_password_choice)"

    { printf '%s\n' "$plain"; printf '%s\t%s\t%s\t%s\n' "$label" "$user" "$pw" "$(date +%F)"; } | encrypt_stdin
    copy_clear "$pw"
    msg "Added '$label' (user: ${user:-none})."
}

cmd_edit() {
    ensure_mounted
    local label="${1:-}"
    [ -z "$label" ] && { err "usage: vault edit <label>"; exit 1; }
    local row; row="$(find_row "$label")"
    [ -z "$row" ] && { err "No entry '$label'. Use 'vault add $label' instead."; exit 1; }

    local cur_user cur_pass
    cur_user="$(printf '%s' "$row" | cut -f2)"
    cur_pass="$(printf '%s' "$row" | cut -f3)"

    local new_user new_pass
    read -rp "username [$cur_user]: " new_user </dev/tty
    [ -z "$new_user" ] && new_user="$cur_user"
    msg "Password for $label:"
    new_pass="$(read_password_choice "$cur_pass")"

    local plain
    # values go through the environment, not awk -v, so the password is
    # never in a process's argv (where ps could see it)
    plain="$(decrypt | L="$label" U="$new_user" P="$new_pass" D="$(date +%F)" awk -F'\t' -v OFS='\t' \
        '$1==ENVIRON["L"] && NF>=4 { print ENVIRON["L"], ENVIRON["U"], ENVIRON["P"], ENVIRON["D"]; next } { print }')"
    printf '%s\n' "$plain" | encrypt_stdin

    if [ "$new_pass" != "$cur_pass" ]; then copy_clear "$new_pass"; fi
    msg "Updated '$label'."
}

cmd_rm() {
    ensure_mounted
    local label="${1:-}"
    [ -z "$label" ] && { err "usage: vault rm <label>"; exit 1; }
    [ -z "$(find_row "$label")" ] && { err "No entry '$label'."; exit 1; }

    local confirm
    read -rp "Delete '$label'? [y/N] " confirm </dev/tty
    case "$confirm" in
        y|Y|yes) ;;
        *) msg "Cancelled."; return 0 ;;
    esac

    local plain
    plain="$(decrypt | awk -F'\t' -v l="$label" '$1==l && NF>=4 {next} {print}')"
    printf '%s\n' "$plain" | encrypt_stdin
    msg "Deleted '$label'."
}

cmd_get() {
    local label="${1:-}" mode="pass" show=0
    shift || true
    while [ $# -gt 0 ]; do
        case "$1" in
            --user) mode="user" ;;
            --show) show=1 ;;
            *) ;;
        esac
        shift
    done
    [ -z "$label" ] && { err "usage: vault get <label> [--user] [--show]"; exit 1; }
    local row; row="$(find_row "$label")"
    [ -z "$row" ] && { err "No entry '$label'."; exit 1; }
    local user pass; user="$(printf '%s' "$row" | cut -f2)"; pass="$(printf '%s' "$row" | cut -f3)"

    if [ "$show" -eq 1 ]; then
        printf 'label:    %s\nusername: %s\npassword: %s\n' "$label" "$user" "$pass"
        return 0
    fi
    if [ "$mode" = "user" ]; then
        printf '%s' "$user" | wl-copy
        msg "Username for '$label' copied."
    else
        copy_clear "$pass"
    fi
}

cmd_import() { # reads TSV "label\tuser\tpass" on stdin; never prints values
    ensure_mounted
    local imp; imp="$(cat)"
    if [ -z "$imp" ]; then msg "Nothing to import."; return 0; fi
    local today; today="$(date +%F)"
    local existing; existing="$(decrypt)"
    local before after merged
    before="$(printf '%s\n' "$existing" | awk -F'\t' 'NF>=4 && $1!~/^#/' | wc -l)"
    merged="$(
      { printf '%s\n' "$existing" | awk -F'\t' 'NF>=4 && $1!~/^#/';
        printf '%s\n' "$imp" | awk -F'\t' -v d="$today" 'NF>=3{print $1"\t"$2"\t"$3"\t"d}';
      } | awk -F'\t' -v OFS='\t' '{ data[$1]=$0 } END { for (k in data) print data[k] }'
    )"
    { printf '# label\tusername\tpassword\tdate\n'; printf '%s\n' "$merged"; } | encrypt_stdin
    after="$(printf '%s\n' "$merged" | sed '/^$/d' | wc -l)"
    msg "Import complete: $after entries in vault (was $before)."
}

cmd_menu() {
    ensure_mounted
    while true; do
        local list
        list="$(rows | awk -F'\t' '{printf "%s\t%s\n", $1, ($2==""?"-":$2)}')"
        if [ -z "$list" ]; then
            warn "Vault is empty."
            list=""
        fi

        local sel key line label
        sel="$(printf '%s\n' "$list" | fzf \
            --prompt="vault> " \
            --delimiter=$'\t' --with-nth=1,2 \
            --header=$'enter: copy password   alt-u: copy username   alt-e: edit   alt-d: delete   alt-a: add   esc: quit' \
            --expect=alt-u,alt-e,alt-d,alt-a \
            --height=~60% --border --reverse)" || { msg "Bye."; break; }

        key="$(printf '%s\n' "$sel" | sed -n '1p')"
        line="$(printf '%s\n' "$sel" | sed -n '2p')"

        if [ -z "$key" ] && [ -z "$line" ]; then
            # alt-a with no line selected (empty vault) -> treat as add
            key="alt-a"
        fi

        case "$key" in
            alt-a)
                cmd_add; continue ;;
            alt-e)
                [ -z "$line" ] && continue
                label="${line%%$'\t'*}"; cmd_edit "$label"; continue ;;
            alt-d)
                [ -z "$line" ] && continue
                label="${line%%$'\t'*}"; cmd_rm "$label"; continue ;;
            alt-u)
                [ -z "$line" ] && continue
                label="${line%%$'\t'*}"; cmd_get "$label" --user; break ;;
            *)
                [ -z "$line" ] && continue
                label="${line%%$'\t'*}"; cmd_get "$label"; break ;;
        esac
    done
}

# --------------------------------------------------------------- dispatch --

case "${1:-menu}" in
    mount)          ensure_mounted; msg "iPod mounted at $MP." ;;
    umount|unmount) do_umount ;;
    decrypt)        decrypt ;;
    ls|list)        cmd_ls ;;
    add)            shift; cmd_add "${1:-}" ;;
    edit)           shift; cmd_edit "${1:-}" ;;
    rm|del|delete)  shift; cmd_rm "${1:-}" ;;
    get|show)       shift; cmd_get "$@" ;;
    import)         cmd_import ;;
    menu)           cmd_menu ;;
    -h|--help|help)
        awk 'NR>1 && /^#/ { sub(/^# ?/, ""); print; next } NR>1 { exit }' "$0" ;;
    *)
        err "unknown command: $1"
        echo "Run 'vault help' for usage." >&2
        exit 1
        ;;
esac
