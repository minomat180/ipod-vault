#!/usr/bin/env bash
# genpass-copy - generate a strong password, copy to clipboard, notify.
#   genpass-copy [genpass.sh flags]     e.g. -l 40, -s, -w
#
# To SAVE a password into the encrypted iPod vault, use the menu instead
# (`vault` -> "Add new entry"), which encrypts it. This tool only copies;
# it never writes plaintext anywhere.
set -euo pipefail

pass="$("$HOME/bin/genpass.sh" "$@")"
printf '%s' "$pass" | wl-copy

# clear clipboard after 45s so it doesn't linger
( sleep 45; wl-copy --clear ) >/dev/null 2>&1 &

notify-send -t 4000 "Password copied" "Length ${#pass} · clears in 45s"
